{
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "unused-imports"],
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended",
    "plugin:@typescript-eslint/recommended",
    // Uncomment the following lines to enable eslint-config-prettier
    // Is not enabled right now to avoid issues with the Next.js repo
    "prettier"
  ],
  "env": {
    "es6": true,
    "browser": true,
    "jest": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    "react-hooks/exhaustive-deps": [
      "warn",
      {
        "additionalHooks": "(useAsync|useAsyncCallback|useAsyncAbortable)"
      }
    ],
    "react/react-in-jsx-scope": 0,
    "react/display-name": 0,
    "react/prop-types": 0,
    "unused-imports/no-unused-imports": "error",
    //"@typescript-eslint/no-unnecessary-condition": "error",
    "@typescript-eslint/explicit-function-return-type": 0,
    "@typescript-eslint/explicit-module-boundary-types": 0,
    "@typescript-eslint/explicit-member-accessibility": 0,
    "@typescript-eslint/indent": 0,
    "@typescript-eslint/member-delimiter-style": 0,
    "@typescript-eslint/ban-ts-comment": 0,
    "@typescript-eslint/no-non-null-assertion": 0, // days are numbered
    "@typescript-eslint/no-explicit-any": 0,
    "@typescript-eslint/no-var-requires": 0,
    // typescript-eslint v8 replaced `no-var-requires` (disabled above) with
    // `no-require-imports`. Kept off to preserve the existing intent: the
    // CommonJS config files (next/jest/tailwind) and a few dynamic requires
    // in source rely on `require()`.
    "@typescript-eslint/no-require-imports": 0,
    "@typescript-eslint/no-use-before-define": 0,
    "@typescript-eslint/no-unused-vars": [
      2,
      {
        "argsIgnorePattern": "^_",
        // typescript-eslint v8 flipped the `caughtErrors` default from "none"
        // to "all". This config predates that change, and the codebase has ~50
        // deliberate `catch (e) { /* swallow */ }` blocks. Restore the default
        // the config was written against rather than churn every catch site.
        "caughtErrors": "none"
      }
    ]
  }
}
