# Run in context of one realm: starts with default realm and disables realms page navigation
# REALM=MNGO
MAINNET_RPC=https://rpc.marinade.finance
DEVNET_RPC=https://api.devnet.solana.com

DEFAULT_GOVERNANCE_PROGRAM_ID=GTesTBiEWE32WHXXE2S4XbZvA5CrEc4xs6ZgRe895dP

# Jupiter's swap API. `quote-api.jup.ag` was retired and no longer resolves;
# `api.jup.ag/swap/v1` is the successor. Only used by the Mango listing tools.
NEXT_PUBLIC_JUPTER_SWAP_API_ENDPOINT=https://api.jup.ag/swap/v1

# Hub GraphQL backend. The former host `api.realms.today` has been retired
# (NXDOMAIN) and has no drop-in successor: `realms-api.com` is a REST API with a
# different shape and `realms-api.com/graphql` 404s. Left blank deliberately —
# the Hub surfaces (feed, discover, stats, ecosystem, realm metadata editing)
# render empty with an explanatory banner, while the on-chain governance pages
# under /dao are unaffected. See KNOWN_ISSUES.md.
NEXT_PUBLIC_API_ENDPOINT=

NEXT_PUBLIC_DISCORD_APPLICATION_CLIENT_ID=1042836142560645130
NEXT_PUBLIC_DISCORD_MATCHDAY_CLIENT_ID=1044361939322683442

# Helius DAS endpoints, used for NFT / compressed-asset views. Leaving these
# empty makes NFT-touching surfaces degrade to "no NFTs" rather than crash.
NEXT_PUBLIC_HELIUS_MAINNET_RPC=
NEXT_PUBLIC_HELIUS_DEVNET_RPC=

# Set to `true` to skip `.sol` domain enumeration, which costs one
# getProgramAccounts scan per queried treasury wallet. Domain names are
# cosmetic, so this is a safe escape hatch for rate-limited RPC providers.
NEXT_PUBLIC_DISABLE_SNS=
